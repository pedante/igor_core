NAME: db_vacuum_stale
DESCRIPTION: Run VACUUM ANALYZE — reclaims dead tuples and updates query planner statistics. No downtime; runs while service is live.
SYMPTOM_CODE: db_vacuum_stale
SYMPTOM_TEXT: 
FIX_TIER: SAFE
FIX_CMD: docker compose exec -T ${DIAG_DB_SVC:-db} psql -U 'nextcloud' -d 'nextcloud' -c 'VACUUM ANALYZE;'
