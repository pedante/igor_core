{
  "contract_version": 1,
  "contributions": [
    {
      "kind": "observer",
      "id": "network.interfaces",
      "handler": "system__observe_interfaces",
      "output_type": "network.interfaces",
      "timeout_seconds": 10,
      "object_kind": "interface",
      "properties": [
        {
          "name": "interface.name",
          "value_type": "string"
        },
        {
          "name": "interface.ifindex",
          "value_type": "integer",
          "minimum": 1
        },
        {
          "name": "interface.operstate",
          "value_type": "string"
        },
        {
          "name": "interface.admin_up",
          "value_type": "boolean"
        },
        {
          "name": "interface.carrier",
          "value_type": "boolean"
        },
        {
          "name": "interface.mtu",
          "value_type": "integer",
          "minimum": 1
        },
        {
          "name": "interface.mac",
          "value_type": "string"
        },
        {
          "name": "interface.kind",
          "value_type": "string"
        },
        {
          "name": "interface.wireless",
          "value_type": "boolean"
        },
        {
          "name": "interface.ipv4_addresses",
          "value_type": "string"
        },
        {
          "name": "interface.ipv6_addresses",
          "value_type": "string"
        },
        {
          "name": "interface.default_route_v4",
          "value_type": "boolean"
        },
        {
          "name": "interface.default_route_v6",
          "value_type": "boolean"
        }
      ],
      "freshness_seconds": 30,
      "privilege": "none",
      "requires": {
        "bins": [
          "ip"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "system.network.summary",
      "handler": "system__network_summary",
      "capability_version": 2,
      "description": "Summarize bounded current interface, route and configured resolver state without connectivity probing.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "interface_count": {
            "type": "integer",
            "minimum": 0
          },
          "admin_up_count": {
            "type": "integer",
            "minimum": 0
          },
          "carrier_count": {
            "type": "integer",
            "minimum": 0
          },
          "wireless_count": {
            "type": "integer",
            "minimum": 0
          },
          "default_route_v4": {
            "type": "string",
            "maxLength": 1024
          },
          "default_route_v6": {
            "type": "string",
            "maxLength": 1024
          },
          "resolver_count": {
            "type": "integer",
            "minimum": 0
          },
          "resolver_local_stub": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "interface_count",
          "admin_up_count",
          "carrier_count",
          "wireless_count",
          "default_route_v4",
          "default_route_v6",
          "resolver_count",
          "resolver_local_stub",
          "source"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": [
        {
          "object": "host",
          "id": "local"
        }
      ],
      "requires": {
        "bins": [
          "ip"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "system.network.interfaces.list",
      "handler": "system__network_interfaces_list",
      "capability_version": 2,
      "description": "List bounded current network interfaces and normalized address/default-route state.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "interfaces": {
            "type": "string",
            "maxLength": 4096
          },
          "source": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "count",
          "interfaces",
          "source"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": [
        {
          "object": "host",
          "id": "local"
        }
      ],
      "requires": {
        "bins": [
          "ip"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "system.network.interface.status",
      "handler": "system__network_interface_status",
      "capability_version": 2,
      "description": "Inspect one canonical current interface object.",
      "inputs": {
        "properties": {
          "interface": {
            "type": "object_id",
            "validator": "object_id",
            "selector": {
              "schema_version": 1,
              "kind": "resource",
              "resource_kind": "interface"
            }
          }
        },
        "required": [
          "interface"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "object_id": {
            "type": "object_id"
          },
          "name": {
            "type": "string",
            "maxLength": 32
          },
          "ifindex": {
            "type": "integer",
            "minimum": 1
          },
          "operstate": {
            "type": "string",
            "maxLength": 32
          },
          "admin_up": {
            "type": "boolean"
          },
          "carrier": {
            "type": "boolean"
          },
          "mtu": {
            "type": "integer",
            "minimum": 1
          },
          "mac": {
            "type": "string",
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "maxLength": 64
          },
          "wireless": {
            "type": "boolean"
          },
          "ipv4_addresses": {
            "type": "string",
            "maxLength": 4096
          },
          "ipv6_addresses": {
            "type": "string",
            "maxLength": 8192
          },
          "default_route_v4": {
            "type": "boolean"
          },
          "default_route_v6": {
            "type": "boolean"
          }
        },
        "required": [
          "object_id",
          "name",
          "ifindex",
          "operstate",
          "admin_up",
          "carrier",
          "mtu",
          "mac",
          "kind",
          "wireless",
          "ipv4_addresses",
          "ipv6_addresses",
          "default_route_v4",
          "default_route_v6"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": [
        {
          "object": "interface",
          "input": "interface"
        }
      ],
      "requires": {
        "bins": [
          "ip"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "system.network.routes.list",
      "handler": "system__network_routes_list",
      "capability_version": 2,
      "description": "List the bounded normalized current IPv4 and IPv6 route table without creating durable route objects.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "routes": {
            "type": "string",
            "maxLength": 4096
          },
          "source": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "count",
          "routes",
          "source"
