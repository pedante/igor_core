          "object": "host",
          "id": "local"
        }
      ],
      "requires": {
        "bins": [
          "ip"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "system.network.dns.status",
      "handler": "system__network_dns_status",
      "capability_version": 2,
      "description": "Inspect configured resolver endpoints and resolv.conf source context without claiming upstream recursive resolver identity.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "nameserver_count": {
            "type": "integer",
            "minimum": 0
          },
          "nameservers": {
            "type": "string",
            "maxLength": 4096
