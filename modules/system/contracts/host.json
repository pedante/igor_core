    {
      "kind": "capability",
      "id": "system.service.restart",
      "handler": "system__privileged_marker",
      "capability_version": 1,
      "description": "Restart one existing systemd service through Igor's reviewed privilege adapter.",
      "inputs": {
        "properties": {
          "unit": {
            "type": "string",
            "validator": "systemd_unit",
            "maxLength": 256,
            "selector": {
              "schema_version": 1,
              "kind": "resource",
              "resource_kind": "service"
            }
          }
        },
        "required": [
          "unit"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "CHANGE"
      },
      "privilege": "required",
      "preconditions": [
        {
          "kind": "owner_active"
        },
        {
          "kind": "service_exists",
          "input": "unit"
        }
      ],
      "verification": {
        "kind": "service_state",
        "input": "unit",
        "equals": "active",
        "required": true
      },
      "recovery": {
        "class": "best_effort",
        "description": "Service restart has no generic rollback; inspect service state/logs and apply a service-specific recovery if required."
      },
      "affects": [
        {
          "object": "service",
          "input": "unit"
        }
      ],
      "requires": {
        "platform_families": [
          "debian",
          "arch"
        ],
        "bins": [
          "systemctl"
        ]
      }
    },
