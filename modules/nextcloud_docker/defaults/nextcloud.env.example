# ==============================================================================
#  IGOR — Nextcloud Docker Module Configuration
#  Install template — copied to config/variables/nextcloud.env on first install.
#
#  Site-specific overrides (HD_MOUNT, NC_DATA, DOMAIN, NC_USER_NAME) belong
#  in secrets/site.env, not here. This file ships with safe generic defaults.
# ==============================================================================

# ── Container user IDs ───────────────────────────────────────────────────────
# These must match the UID/GID of the www-data user in the custom Nextcloud image
NC_UID=1004
NC_GID=1004

# ── External storage mount points ───────────────────────────────────────────────
# Location where external USB hard drive is mounted
HD_MOUNT=/mnt/nextclouddata

# Path to Nextcloud data directory (relative to HD_MOUNT)
NC_DATA=/mnt/nextclouddata/next

# ── Network Port Configuration ────────────────────────────────────────────────────
# Default ports for the Nextcloud stack
NEXTCLOUD_HTTP_PORT=8080
NEXTCLOUD_FPM_PORT=9000
POSTGRES_PORT=5432
REDIS_PORT=6379
ONLYOFFICE_PORT=8081

# ── Container Configuration ──────────────────────────────────────────────────────
# Default container names and settings
NEXTCLOUD_WEB_CONTAINER="web"
NEXTCLOUD_APP_CONTAINER="app"
NEXTCLOUD_DB_CONTAINER="db"
NEXTCLOUD_REDIS_CONTAINER="redis"
NEXTCLOUD_CRON_CONTAINER="cron"

# ── nginx template variables ──────────────────────────────────────────────────
# Rendered into web/nginx.conf via: envsubst < web/nginx.conf.tmpl > web/nginx.conf
UPLOAD_MAX=10G
FASTCGI_TIMEOUT=300

# ── Docker Configuration ──────────────────────────────────────────────────────────────
# Docker compose file path
COMPOSE_FILE="./config/stacks/nextcloud/docker-compose.yml"

# ── URLs and Endpoints ────────────────────────────────────────────────────────────
# Default URLs (can be overridden by environment)
NEXTCLOUD_STATUS_URL="http://localhost:${NEXTCLOUD_HTTP_PORT}/status.php"
NEXTCLOUD_APPS_URL="http://localhost:${NEXTCLOUD_HTTP_PORT}/apps/files/"
NEXTCLOUD_WEBFINGER_URL="http://localhost:${NEXTCLOUD_HTTP_PORT}/.well-known/webfinger"

# ── Supervised app install ────────────────────────────────────────────────────
# Seconds to observe app container logs after install
SUPERVISED_INSTALL_WINDOW=90

# Apps that need a Pi 3 RAM warning before install
HEAVY_APPS="memories recognize AppAPI onlyoffice richdocuments fulltextsearch"

# ==============================================================================
#  DO NOT EDIT THIS FILE DIRECTLY
#  Override these values in environment variables or user config files.
# ==============================================================================