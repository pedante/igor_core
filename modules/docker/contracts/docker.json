{
  "contract_version": 1,
  "contributions": [
    {
      "kind": "capability",
      "id": "docker.status",
      "handler": "docker__status",
      "capability_version": 2,
      "description": "Inspect whether the Docker CLI is installed and whether the local daemon is reachable.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "installed": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "maxLength": 128
          },
          "daemon_accessible": {
            "type": "boolean"
          }
        },
        "required": [
          "installed",
          "version",
          "daemon_accessible"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": []
    },
    {
      "kind": "capability",
      "id": "docker.container.list",
      "handler": "docker__container_list",
      "capability_version": 2,
      "description": "List the local Docker containers without changing them.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "containers": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "available",
          "count",
          "containers"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": [],
      "requires": {
        "bins": [
          "docker"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "docker.container.restart",
      "handler": "docker__container_restart",
      "capability_version": 2,
      "description": "Restart one explicitly named Docker container through Igor's normal approval dispatcher.",
      "inputs": {
        "properties": {
          "container": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "container"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "container": {
            "type": "string",
            "maxLength": 128
          },
          "result": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "container",
          "result"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "CHANGE"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "best_effort",
        "description": "The restart itself is transient; inspect container state and logs if recovery is needed."
      },
      "affects": [],
      "requires": {
        "bins": [
          "docker"
        ]
      }
    },
    {
      "kind": "plan",
      "id": "docker.install",
      "plan_version": 1,
      "description": "Install Docker using the host package provider, enable it at boot, and start the daemon.",
      "intended_outcome": "Docker Engine is installed and docker.service is enabled and active.",
      "objects": [
        "package:pkg_docker",
        "service:systemd:docker.service"
      ],
      "steps": [
        {
          "capability_id": "system.package.install",
          "inputs": {
            "package": "pkg_docker"
          }
        },
        {
          "capability_id": "system.service.enable",
          "inputs": {
            "unit": "docker.service"
          }
        },
        {
          "capability_id": "system.service.start",
          "inputs": {
            "unit": "docker.service"
          }
        }
      ],
      "final_check": null,
      "requires": {
        "capabilities": [
          "system.package.install",
          "system.service.enable",
          "system.service.start"
        ],
        "platform_families": [
          "debian",
          "arch"
        ]
      }
    }
  ]
}
