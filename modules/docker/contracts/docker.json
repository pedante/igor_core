{
  "contract_version": 1,
  "contributions": [
    {
      "kind": "capability",
      "id": "docker.status",
      "handler": "docker__status",
      "capability_version": 2,
      "description": "Inspect whether the Docker CLI is installed and whether the local daemon is reachable.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "installed": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "maxLength": 128
          },
          "daemon_accessible": {
            "type": "boolean"
          }
        },
        "required": [
          "installed",
          "version",
          "daemon_accessible"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": []
    },
    {
      "kind": "capability",
      "id": "docker.container.list",
      "handler": "docker__container_list",
      "capability_version": 2,
      "description": "List the local Docker containers without changing them.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "containers": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "available",
          "count",
          "containers"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "READ"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "not_applicable"
      },
      "affects": [],
      "requires": {
        "bins": [
          "docker"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "docker.container.restart",
      "handler": "docker__container_restart",
      "capability_version": 2,
      "description": "Restart one explicitly named Docker container through Igor's normal approval dispatcher.",
      "inputs": {
        "properties": {
          "container": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "container"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "schema_version": 1,
        "properties": {
          "container": {
            "type": "string",
            "maxLength": 128
          },
          "result": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "container",
          "result"
        ],
        "additionalProperties": false
      },
      "safety": {
        "tier": "CHANGE"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "best_effort",
        "description": "The restart itself is transient; inspect container state and logs if recovery is needed."
      },
      "affects": [],
      "requires": {
        "bins": [
          "docker"
        ]
      }
    },
    {
      "kind": "capability",
      "id": "docker.install",
      "capability_version": 1,
      "description": "Install and activate Docker through a data-only composition of canonical host capabilities.",
      "inputs": {
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "safety": {
        "tier": "CHANGE"
      },
      "privilege": "none",
      "preconditions": [
        {
          "kind": "owner_active"
        }
      ],
      "verification": {
        "kind": "none",
        "required": false
      },
      "recovery": {
        "class": "best_effort",
        "description": "A stopped composition is recorded as partial progress. Removal or rollback is a separately approved capability request."
      },
      "affects": [],
      "implementation": {
        "kind": "composition",
        "intended_outcome": "Docker Engine is installed and docker.service is enabled, active, and reachable.",
        "variants": [
          {
            "requires": {
              "platform_families": [
                "debian"
              ]
            },
            "steps": [
              {
                "capability_id": "system.package.install",
                "inputs": {
                  "package": "docker.io"
                }
              },
              {
                "capability_id": "system.service.enable",
                "inputs": {
                  "unit": "docker.service"
                }
              },
              {
                "capability_id": "system.service.start",
                "inputs": {
                  "unit": "docker.service"
                }
              }
            ]
          },
          {
            "requires": {
              "platform_families": [
                "arch"
              ]
            },
            "steps": [
              {
                "capability_id": "system.package.install",
                "inputs": {
                  "package": "docker"
                }
              },
              {
                "capability_id": "system.service.enable",
                "inputs": {
                  "unit": "docker.service"
                }
              },
              {
                "capability_id": "system.service.start",
                "inputs": {
                  "unit": "docker.service"
                }
              }
            ]
          }
        ],
        "final_check": {
          "capability_id": "docker.status",
          "inputs": {},
          "expect": {
            "installed": true,
            "daemon_accessible": true
          }
        }
      },
      "requires": {
        "capabilities": [
          "system.package.install",
          "system.service.enable",
          "system.service.start"
        ]
      }
    }
  ]
}
