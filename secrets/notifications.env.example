# ============================================================
#  secrets/notifications.env — SMTP notification password
#  cp notifications.env.example notifications.env && chmod 600
# ============================================================

NOTIFY_SMTP_PASS=change_me
NOTIFY_ON_HEALTH_CRITICAL=true
NOTIFY_ON_SERVICE_DOWN=true
NOTIFY_ON_STACK_DOWN=true
NOTIFY_ON_FIX_FAILED=true
NOTIFY_ON_BACKUP_FAIL=true
NOTIFY_ON_APP_INSTALL=true
NOTIFY_ON_DESTROY_ACTION=true
NOTIFY_ON_JOURNAL_FAIL=true
NOTIFY_ON_FIX_APPLIED=false
NOTIFY_ON_BACKUP_DONE=true
