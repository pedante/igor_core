# ============================================================
#  secrets/db.env — PostgreSQL + Nextcloud credentials
#  cp db.env.example db.env && chmod 600 db.env, then edit.
# ============================================================

# PostgreSQL
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nextcloud

# Nextcloud admin account (first install only)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me

# Trusted domains — space-separated
NEXTCLOUD_TRUSTED_DOMAINS=localhost

POSTGRES_HOST=db
