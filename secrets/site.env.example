# ============================================================
#  secrets/site.env.example — site-specific overrides template
#  cp site.env.example site.env && chmod 600 site.env, then edit.
#
#  Overrides the generic defaults in config/variables/*.env.
# ============================================================

# ── Paths ─────────────────────────────────────────────────────────────────────
# HD_MOUNT="/mnt/nextclouddata"       # where your USB drive is mounted
# NC_DATA="${HD_MOUNT}/next"          # Nextcloud data directory
# INSTALL_DIR="/opt/nextcloud"        # Docker Compose project root

# ── Identity ──────────────────────────────────────────────────────────────────
# NC_USER_NAME="pi"                   # Linux user that owns NC_DATA

# ── Domain ────────────────────────────────────────────────────────────────────
# DOMAIN="your.domain.here"           # public domain via Cloudflare Tunnel
# TUNNEL_NAME="nextcloud-tunnel"      # tunnel name in the Cloudflare dashboard
