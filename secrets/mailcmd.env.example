# ============================================================
#  secrets/mailcmd.env — Email command interface credentials
#  cp mailcmd.env.example mailcmd.env && chmod 600 mailcmd.env
# ============================================================

MAILCMD_IMAP_HOST=imap.example.com
MAILCMD_IMAP_PORT=993
MAILCMD_IMAP_TLS=ssl
MAILCMD_IMAP_USER=igor@example.com
MAILCMD_IMAP_PASS=change_me
MAILCMD_IMAP_FOLDER=INBOX

MAILCMD_SMTP_HOST=smtp.example.com
MAILCMD_SMTP_PORT=587
MAILCMD_SMTP_TLS=starttls
MAILCMD_SMTP_USER=igor@example.com
MAILCMD_SMTP_PASS=change_me

MAILCMD_FROM_ADDR=igor@example.com
MAILCMD_OPERATOR_EMAIL=admin@example.com
MAILCMD_GPG_EMAIL=igor@hostname
MAILCMD_OPERATOR_KEY_ID=XXXXXXXXXXXXXXXX
MAILCMD_ENABLED=false
