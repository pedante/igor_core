# =============================================================================
#  IGOR CORE CONFIGURATION — variables/igor.env
#
#  Global settings for the Igor installation: paths, identity, and behaviour.
#  Edit these once during initial setup; they rarely need to change afterwards.
#
#  Sensitive values (passwords, API keys) belong in secrets/ — not here.
# =============================================================================

# --- Paths --------------------------------------------------------------------
# Where the external hard drive is mounted on the Pi.
# Igor uses this to check mount status and calculate free space.
HD_MOUNT="/mnt/nextclouddata"

# Nextcloud data directory (user files). Must be on the external drive.
# This is the value of 'datadirectory' in Nextcloud's config.php.
NC_DATA="${HD_MOUNT}/next"

# Legacy install directory reference (used by some older menu items).
# Points to the Docker Compose project root on the Pi.
INSTALL_DIR="/opt/nextcloud"

# --- User / permission mapping -----------------------------------------------
# UID and GID that the Nextcloud PHP-FPM process runs as inside the container.
# Must match the ownership of NC_DATA on the host. Default: 1004
NC_UID=1004
NC_GID=1004

# The Linux username on the Pi that owns NC_DATA (used in permission checks).
NC_USER_NAME="pi"

# --- Network / Cloudflare -----------------------------------------------------
# Public domain Igor is reachable at (via Cloudflare Tunnel).
# Used to build trusted_domains, overwrite.cli.url, and diagnostic URLs.
# ⚠ REQUIRED: replace with your own domain before first run.
DOMAIN="your.domain.here"

# Cloudflare Tunnel name (as shown in the Cloudflare dashboard).
TUNNEL_NAME="nextcloud-tunnel"

# --- Maintenance schedules ----------------------------------------------------
# AUTO_RESCAN: automatically run `occ files:scan` after storage changes.
# Values: true | false
AUTO_RESCAN="false"

# PREVIEW_CRON: enable the background preview generation cron task.
# Disable on Pi 3 (1 GB RAM) to avoid OOM — generate previews on-demand instead.
# Values: true | false
PREVIEW_CRON="false"

# BACKUP_FULL_DOW: day of week for full backups (0=Sunday … 6=Saturday).
# Incremental backups run daily; full backup runs on this day only.
BACKUP_FULL_DOW=3

# --- UI / verbosity -----------------------------------------------------------
# NEXUS_VERBOSE: enable verbose logging throughout all Igor subsystems.
# Values: true | false
NEXUS_VERBOSE=true

# IGOR_USE_TMUX: enable fzf popup menus and the split AI panel in tmux.
# Default true — Igor will offer to install fzf/tmux on first run if missing.
# Set to false to use plain-text menus with no tmux dependency.
# Values: true | false
IGOR_USE_TMUX=false

# IGOR_FZF_ALREADY_ASKED: set automatically to true after the one-time
# "install fzf/tmux?" prompt. Do not edit unless you want to be asked again.
IGOR_FZF_ALREADY_ASKED=true

# RECENT_MENU_COUNT: how many recently-used menu items to show at the top.
RECENT_MENU_COUNT=5

# --- Health / alerts ----------------------------------------------------------
# HEALTH_CHECK_INTERVAL: seconds between automatic health checks (default: 5 min).
HEALTH_CHECK_INTERVAL=300

# ALERT_STALE_AFTER: seconds before a repeated alert is suppressed (default: 4 h).
ALERT_STALE_AFTER=14400

# BACKUP_KEEP_COUNT: how many backup archives to retain before rotating old ones.
BACKUP_KEEP_COUNT=5
