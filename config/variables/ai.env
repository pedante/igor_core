# =============================================================================
#  AI ASSISTANT CONFIGURATION — variables/ai.env
#
#  Controls which AI provider and model Igor uses for diagnostics,
#  how the ReAct loop behaves, and session safety limits.
#
#  API keys are NOT stored here — put them in secrets/:
#    secrets/anthropic.key   — Anthropic API key (one line, no quotes)
#    secrets/openrouter.key  — OpenRouter API key (one line, no quotes)
# =============================================================================

# --- Provider -----------------------------------------------------------------
# Which AI backend to use.
# Values: anthropic | openrouter
provider=openrouter

# --- Model selection ----------------------------------------------------------
# The model to request from the provider.
#
# Anthropic models (use with provider=anthropic):
#   claude-opus-4-6            — most capable, highest cost
#   claude-sonnet-4-6          — best balance of capability and speed (recommended)
#   claude-haiku-4-5-20251001  — fastest and cheapest
#
# OpenRouter models (prefix with provider slug, use with provider=openrouter):
#   anthropic/claude-sonnet-4-6
#   deepseek/deepseek-chat-v3-0324  — strong reasoning, very low cost
#   google/gemini-2.0-flash-001
#
# Dual-model: set model (thinking) and model_act (fast execution) separately.
# Leave model_act blank to use the same model for everything.
model=deepseek/deepseek-chat-v3-0324
# model_act=anthropic/claude-haiku-4-5-20251001

# --- Generation parameters ----------------------------------------------------
# Maximum tokens Igor may generate per API response.
# Higher = more detailed analysis but slower and costlier. Range: 1024–32768
max_tokens=2048

# Sampling temperature (0.0–2.0).
# 0.0 = fully deterministic  |  0.7 = balanced  |  1.0+ = more varied
temperature=0.7

# --- ReAct loop behaviour -----------------------------------------------------
# Maximum tool-call iterations per question (safety breaker for runaway loops).
# Recommended: 10–20
# AI_MAX_ITERATIONS=15

# Maximum spend (USD) allowed in a single session. 0 = no cap.
# AI_SESSION_COST_CAP=1.00

# --- Mode flags ---------------------------------------------------------------
# Canonical interaction mode: guide | assist | executive.
# Guide proposes READ actions, Assist runs READ actions automatically, and
# Executive may run administrator-approved CHANGE actions automatically.
# Legacy compatibility flag. New settings are written with ai_mode; when
# ai_mode is absent, executive_mode=true migrates to Executive and false to Assist.
executive_mode=false

# verbose is a legacy compatibility input for installations that have not cut
# this key over. Once ai.verbose is authoritative in Configuration Service, this
# file cannot override the stored desired value. Use Igor's settings/capability
# path for authoritative changes after cutover.
verbose=true

# AI_AUTOSTART: launch the AI assistant automatically when igor.sh starts.
# Useful on a headless Pi where you always want the AI session running.
AI_AUTOSTART=false

# AI_HYBRID_MODE: use a cheap fast model for tool calls and a smarter model
# for final synthesis. Reduces cost on long diagnostic sessions.
AI_HYBRID_MODE=false

# --- Administrator policy (enforced outside the model) -------------------------
# Disables model requests and tool dispatch. Status/last remain available.
IGOR_AI_ENABLED=true
# Canonical names shown by --ai tools; comma separated, all, or empty (no tools).
# execute/host_command aliases are controlled by host.
IGOR_AI_ALLOWED_TOOLS=all
# Disable selected registered module action names without disabling the module.
IGOR_AI_DISABLED_ACTIONS=
# standard: host/module observations and saved reference data. minimal: requests
# and explicitly requested tool results only; no automatic context collection.
IGOR_AI_CONTEXT=standard
# metadata: identifiers, decisions, sizes, hashes. sanitized: bounded scrubbed
# argument/result previews too. off: no operational audit. Never stores prompts
# or model reasoning. JSONL is private, capped at approximately 2 MB.
IGOR_AI_AUDIT=metadata

# Step 15D: optional administrator-owned JSON bindings. Roles are reasoner,
# summarizer and context_ranker; omitted reasoner/summarizer inherit provider/model.
# Example: '{"summarizer":{"provider":"ollama","model":"your-local-model"}}'
# No automatic provider fallback, optimization or ranker invocation.
IGOR_AI_ROLE_BINDINGS='{}'
# Hard serialized request limit; token estimates are approximate diagnostics.
IGOR_AI_REQUEST_MAX_BYTES=262144
