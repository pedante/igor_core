# =============================================================================
#  NOTIFICATIONS CONFIGURATION — variables/notifications.env
#
#  Controls outbound email alerts sent by Igor's healing and alert subsystems.
#
#  Your real SMTP credentials belong in secrets/notifications.env — not here:
#    NOTIFY_SMTP_HOST, NOTIFY_SMTP_USER, NOTIFY_SMTP_PASS
#    NOTIFY_FROM, NOTIFY_TO
# =============================================================================

# --- Feature flag -------------------------------------------------------------
NOTIFY_ENABLED=true

# --- SMTP relay ---------------------------------------------------------------
# Real values go in secrets/notifications.env so they are never committed.
NOTIFY_SMTP_HOST=smtp.example.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_TLS=starttls
NOTIFY_SMTP_USER=smtp-user@example.com

# --- Addresses ----------------------------------------------------------------
NOTIFY_FROM=igor@example.com
NOTIFY_TO=admin@example.com

# --- Formatting ---------------------------------------------------------------
NOTIFY_SUBJECT_PREFIX=[IGOR]
