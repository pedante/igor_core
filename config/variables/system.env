# ==============================================================================
#  IGOR — system module defaults
#  config/variables/system.env
#
#  Override any of these in secrets/system.env (chmod 600) if needed.
#  Do NOT commit secrets to git.
# ==============================================================================

# CPU temperature thresholds (°C)
# vcgencmd is used on Raspberry Pi; /sys/class/thermal fallback on other hardware
SYSTEM_TEMP_WARN=75
SYSTEM_TEMP_CRIT=85

# Legacy compatibility input only; this is not the authoritative warning policy.
# D062 does not import SYSTEM_RAM_WARN_MB. The effective migrated warning setting
# is system.memory.warning_threshold_mib (default 150 MiB); the independent
# critical boundary remains 80 MiB. Do not edit this expecting warning behavior
# to change after the Configuration Service cutover.
SYSTEM_RAM_WARN_MB=80

# Disk usage warning threshold (percent used)
# Used by checks/storage.sh
SYSTEM_DISK_WARN_PCT=85
SYSTEM_DISK_CRIT_PCT=95
