# ==============================================================================
#  IGOR — system module defaults
#  config/variables/system.env
#
#  Override any of these in secrets/system.env (chmod 600) if needed.
#  Do NOT commit secrets to git.
# ==============================================================================

# CPU temperature thresholds (°C)
# vcgencmd is used on Raspberry Pi; /sys/class/thermal fallback on other hardware
SYSTEM_TEMP_WARN=75
SYSTEM_TEMP_CRIT=85

# Available RAM warning threshold (MB)
# Alert fires when MemAvailable < this value
SYSTEM_RAM_WARN_MB=80

# Disk usage warning threshold (percent used)
# Used by checks/storage.sh
SYSTEM_DISK_WARN_PCT=85
SYSTEM_DISK_CRIT_PCT=95
