# ==============================================================================
#  IGOR — config/defaults.env
#  Default configuration values for core IGOR functionality.
#
#  These values can be overridden by:
#    1. ~/.config/igor/config.env (user preferences)
#    2. Environment variables (runtime)
#
#  DO NOT store secrets here - use secrets files for credentials.
# ==============================================================================

# ── Identity — update before publishing ───────────────────────────────────────
# GitHub repository URL — used in OpenRouter HTTP-Referer header.
IGOR_GITHUB_URL="https://github.com/yourusername/igor"
IGOR_APP_TITLE="IGOR"

# ── Reports directory ─────────────────────────────────────────────────────────
# Health check and AI diagnosis reports. IGOR_DIR is set before this file is sourced.
REPORTS_DIR="${IGOR_DIR}/data/reports"

# ── AI Hybrid / Autostart ──────────────────────────────────────────────────────
# Jump straight to menu_ai() on script launch (for AI-first users)
AI_AUTOSTART=false

# Main menu also accepts natural-language questions inline (hybrid mode)
AI_HYBRID_MODE=false

# Quiet loop mode: suppress per-step display for READ-only diagnostic loops.
# The user sees only the final answer + a collapsed step summary.
# CHANGE/DESTROY commands still surface their approval prompts regardless.
IGOR_LOOP_QUIET=true

# ── Diagnose subsystem ─────────────────────────────────────────────────────────
# Seconds to wait after a fix before running the targeted recheck
DIAG_SETTLE_SECS=4

# Maximum fix-recheck retries before marking an issue as UNRESOLVED
DIAG_MAX_RETRIES=5

# Number of session report logs to retain (oldest deleted on overflow)
DIAG_REPORT_KEEP=10

# Default watch mode scan interval (seconds)
DIAG_WATCH_INTERVAL=30

# ── Recovery & Backup subsystem ───────────────────────────────────────────────
# Number of config backups to retain (oldest deleted on overflow)
BACKUP_CONFIG_KEEP=7

# Number of full backups to retain
BACKUP_FULL_KEEP=3

# Scheduled daily config backup time (HH:MM, 24-hour)
BACKUP_CONFIG_TIME=03:00

# Scheduled full backup time (HH:MM, 24-hour)
BACKUP_FULL_TIME=03:30

# Day of week for full backup (0=Sunday, 1=Monday, ..., 6=Saturday)
BACKUP_FULL_DOW=0

# ── Change journal ─────────────────────────────────────────────────────────────
# Set to false to disable journal writes (not recommended)
JOURNAL_ENABLED=true

# Max journal.log size before rotation (bytes, default 5MB)
JOURNAL_MAX_SIZE=5242880

# ── Email notifications ────────────────────────────────────────────────────────
# Master switch — false until user configures email via Menu O
NOTIFY_ENABLED=false

# Subject prefix for all notification emails
NOTIFY_SUBJECT_PREFIX="[IGOR]"

# Default TLS mode for SMTP (starttls / ssl / none)
NOTIFY_SMTP_TLS=starttls

# ── Per-event toggles (all critical events on, noisy ones off by default) ──────
NOTIFY_ON_HEALTH_CRITICAL=true
NOTIFY_ON_SERVICE_DOWN=true
NOTIFY_ON_STACK_DOWN=true
NOTIFY_ON_FIX_FAILED=true
NOTIFY_ON_FIX_APPLIED=false
NOTIFY_ON_BACKUP_FAIL=true
NOTIFY_ON_BACKUP_DONE=false
NOTIFY_ON_APP_INSTALL=false
NOTIFY_ON_DESTROY_ACTION=true
NOTIFY_ON_JOURNAL_FAIL=false

# ── Email Command Interface ────────────────────────────────────────────────────
# Master switch — false until user configures via Menu C
MAILCMD_ENABLED=false

# IMAP poll interval in seconds (300 = 5 min, Pi 3 safe)
MAILCMD_POLL_INTERVAL=300

# Minimum seconds between proactive alert emails (900 = 15 min)
MAILCMD_ALERT_INTERVAL=900

# Max bytes of command output to include in response email (50KB)
MAILCMD_OUTPUT_LIMIT=51200

# Time for daily heartbeat email (HH:MM, 24-hour)
MAILCMD_HEARTBEAT_TIME=07:00

# Allow arbitrary shell commands (Mode 2) — false until explicitly enabled
MAILCMD_SHELL_MODE=false

# Seconds of inactivity before shell mode auto-disables (3600 = 60 min)
MAILCMD_SHELL_TIMEOUT=3600